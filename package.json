{
  "name": "hugecatalog",
  "version": "1.0.0",
  "private": true,
  "description": "Каталог манги, манхвы и маньхуа с командами переводчиков, модерацией и читалкой",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/seed-demo.js",
    "import": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/import.js",
    "admin:password": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/admin-password.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "multer": "^2.5.0"
  }
}
