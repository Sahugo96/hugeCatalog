# Скопируйте в .env (файл .env не попадает в git) и заполните.
PORT=3000
# Длинная случайная строка, обязательно в production:
SESSION_SECRET=
# Пароль администратора при первом запуске (логин — admin):
ADMIN_PASSWORD=
# COOKIE_SECURE=1   # если сайт работает по HTTPS
# TRUST_PROXY=1     # если сайт стоит за nginx
