<%- include('../partials/header') %>
<%
  var sel = function (list) { return (list || []).map(String); };
  var selGenres = sel(form.genres), selTags = sel(form.tags);
%>
<div class="container narrow page-pad">
  <div class="breadcrumbs"><a href="/studio"><%= __('Студия') %></a><% if (work) { %> / <a href="/studio/works/<%= work.id %>"><%= work.title %></a><% } %> / <span><%= __(work ? 'Редактирование' : 'Новый тайтл') %></span></div>
  <h1><%= __(work ? 'Редактирование тайтла' : 'Новый тайтл') %></h1>
  <% if (!work && !isStaff) { %>
    <div class="notice notice-info"><%- icon('info') %><div><%= __('После сохранения тайтл уйдёт на модерацию. Пока он на проверке, вы можете загружать главы — они станут видны читателям вместе с одобрением.') %></div></div>
  <% } %>
  <% if (typeof source !== 'undefined' && source) { %>
    <div class="notice notice-info"><%- flag(source.language) %><div><%= __('Новая языковая версия произведения') %> <a href="/title/<%= source.slug %>" target="_blank">«<%= source.title %>»</a><%= __('. Авторы, жанры, теги и описание скопированы — переведите название и описание. После сохранения версии будут связаны автоматически.') %></div></div>
  <% } %>
  <% if (errors.length) { %>
    <div class="notice notice-error"><%- icon('info') %><ul><% errors.forEach(function (e) { %><li><%= __(e) %></li><% }) %></ul></div>
  <% } %>

  <form method="post" enctype="multipart/form-data" action="<%= work ? '/studio/works/' + work.id + '/edit' : '/studio/works/new' %>" class="form" data-unsaved-warning>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (!work && form.link_to) { %><input type="hidden" name="link_to" value="<%= form.link_to %>"><% } %>

    <div class="panel">
      <h2 class="h3"><%= __('Основное') %></h2>
      <div class="cover-field">
        <label class="cover-drop">
          <img data-cover-preview <% if (work && work.cover) { %>src="<%= work.cover %>"<% } else { %>hidden<% } %> alt="">
          <span class="cover-drop-hint" <%= work && work.cover ? 'hidden' : '' %>><%- icon('upload') %><%= __('Обложка') %><br><small><%= __('jpg, png, webp · до 8 МБ') %></small></span>
          <input type="file" name="cover" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" <%= work || (typeof source !== 'undefined' && source) ? '' : 'required' %> data-image-preview>
        </label>
        <div class="grow">
          <label class="field">
            <span><%= __('Название') %><%= __(typeof source !== 'undefined' && source ? ' на языке этой версии' : '') %> *</span>
            <input class="input" name="title" value="<%= form.title || '' %>" required maxlength="200">
          </label>
          <% if (typeof source !== 'undefined' && source && source.cover) { %>
            <label class="check" style="margin-bottom: 12px">
              <input type="checkbox" name="reuse_cover" value="1" <%= form.reuse_cover !== undefined || !errors.length ? 'checked' : '' %>>
              <span><%= __('Если не загружу свою — взять обложку версии «{title}»', { title: source.title }) %></span>
            </label>
          <% } %>
          <label class="field">
            <span><%= __('Альтернативные названия') %></span>
            <textarea class="input" name="alt_titles" rows="3" maxlength="1000" placeholder="<%= __('По одному на строку: оригинальное, английское…') %>"><%= form.alt_titles || '' %></textarea>
          </label>
        </div>
      </div>
      <% if (teams.length || isStaff) { %>
        <label class="field">
          <span><%= __('Команда') %><%= isStaff ? '' : ' *' %></span>
          <select class="input select" name="team_id" <%= isStaff ? '' : 'required' %>>
            <% if (isStaff) { %><option value=""><%= __('— без команды (от администрации) —') %></option><% } %>
            <% teams.forEach(function (t) { %><option value="<%= t.id %>" <%= String(form.team_id) === String(t.id) ? 'selected' : '' %>><%= t.name %></option><% }) %>
          </select>
        </label>
      <% } %>
      <label class="field">
        <span><%= __('Описание') %></span>
        <textarea class="input" name="description" rows="7" maxlength="10000" placeholder="<%= __('О чём это произведение? Описание также используется для подбора похожих по сюжету.') %>"><%= form.description || '' %></textarea>
      </label>
    </div>

    <div class="panel">
      <h2 class="h3"><%= __('Авторы') %></h2>
      <div class="field-row">
        <label class="field">
          <span><%= __('Автор (сценарий) *') %></span>
          <input class="input" name="story_authors" value="<%= form.story_authors || '' %>" required placeholder="<%= __('Через запятую') %>" list="authors-datalist" data-author-input>
        </label>
        <label class="field">
          <span><%= __('Художник') %></span>
          <input class="input" name="artists" value="<%= form.artists || '' %>" placeholder="<%= __('Если отличается от автора') %>" list="authors-datalist" data-author-input>
        </label>
      </div>
      <datalist id="authors-datalist"></datalist>
      <p class="muted small"><%= __('Художник используется для подбора похожих тайтлов «по рисовке».') %></p>
    </div>

    <div class="panel">
      <h2 class="h3"><%= __('Характеристики') %></h2>
      <div class="field">
        <span><%= __('Формат') %></span>
        <% if (!work) { %>
          <div class="pill-radio">
            <label><input type="radio" name="format" value="chapters" <%= form.format !== 'single' ? 'checked' : '' %>><span><%= __('По главам') %></span></label>
            <label><input type="radio" name="format" value="single" <%= form.format === 'single' ? 'checked' : '' %>><span><%= __('Сингл (ваншот)') %></span></label>
          </div>
          <small class="muted"><%= __('Сингл выходит одной галереей страниц, без глав.') %></small>
        <% } else { %>
          <div><span class="badge badge-soft"><%= __(work.is_single ? 'Сингл' : 'По главам') %></span>
            <small class="muted"><%= __(isAdmin ? 'Сменить формат можно на странице произведения в студии.' : 'Сменить формат может администратор.') %></small></div>
        <% } %>
      </div>
      <div class="field-row cols-3">
        <label class="field">
          <span><%= __('Тип *') %></span>
          <select class="input select" name="type" required>
            <% C.TYPES.forEach(function (t) { %><option value="<%= t.value %>" <%= form.type === t.value ? 'selected' : '' %>><%= __(t.label) %></option><% }) %>
          </select>
        </label>
        <label class="field">
          <span><%= __('Язык этой версии *') %></span>
          <select class="input select" name="language" required>
            <% C.LANGUAGES.forEach(function (l) { %><option value="<%= l.value %>" <%= form.language === l.value ? 'selected' : '' %>><%= __(l.label) %></option><% }) %>
          </select>
        </label>
        <label class="field">
          <span><%= __('Год начала') %></span>
          <input class="input" type="number" name="year" min="1900" max="<%= new Date().getFullYear() + 1 %>" value="<%= form.year || '' %>" placeholder="<%= __('напр. 2018') %>">
        </label>
      </div>
      <div class="field-row">
        <div class="field">
          <span><%= __('Статус *') %></span>
          <div class="pill-radio">
            <% C.STATUSES.forEach(function (s) { %>
              <label><input type="radio" name="status" value="<%= s.value %>" <%= form.status === s.value ? 'checked' : '' %> required><span><%= __(s.label) %></span></label>
            <% }) %>
          </div>
        </div>
        <div class="field">
          <span><%= __('Возрастной рейтинг *') %></span>
          <div class="pill-radio">
            <% C.AGE_RATINGS.forEach(function (a) { %>
              <label><input type="radio" name="age_rating" value="<%= a.value %>" <%= form.age_rating === a.value ? 'checked' : '' %> required><span><%= __(a.label) %></span></label>
            <% }) %>
          </div>
        </div>
      </div>
    </div>

    <div class="panel">
      <h2 class="h3"><%= __('Жанры *') %> <span class="muted small" data-checked-count="genres-box"></span></h2>
      <input type="search" class="input input-sm filter-search" placeholder="<%= __('Найти жанр…') %>" data-filter-search="genres-box">
      <div class="check-chips" id="genres-box">
        <% genres.forEach(function (g) { %>
          <label class="check-chip"><input type="checkbox" name="genres" value="<%= g.id %>" <%= selGenres.indexOf(String(g.id)) >= 0 ? 'checked' : '' %>><span><%= __(g.name) %></span></label>
        <% }) %>
      </div>
    </div>

    <div class="panel">
      <h2 class="h3"><%= __('Теги') %> <span class="muted small" data-checked-count="tags-box"></span></h2>
      <p class="muted small"><%= __('Теги из группы «Рисовка» помогают находить похожие по стилю, «Сюжет» — по сюжету.') %></p>
      <input type="search" class="input input-sm filter-search" placeholder="<%= __('Найти тег…') %>" data-filter-search="tags-box">
      <div id="tags-box">
        <% tagGroups.forEach(function (g) { %>
          <div class="tag-block">
            <div class="filter-title"><%= __(g.group) %></div>
            <div class="check-chips">
              <% g.tags.forEach(function (t) { %>
                <label class="check-chip"><input type="checkbox" name="tags" value="<%= t.id %>" <%= selTags.indexOf(String(t.id)) >= 0 ? 'checked' : '' %>><span><%= __(t.name) %></span></label>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="form-footer">
      <a href="<%= work ? '/studio/works/' + work.id : '/studio' %>" class="btn btn-ghost"><%= __('Отмена') %></a>
      <button class="btn btn-primary" type="submit"><%- icon('check') %><%= __(work ? 'Сохранить' : (isStaff ? 'Опубликовать' : 'Отправить на модерацию')) %></button>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>
