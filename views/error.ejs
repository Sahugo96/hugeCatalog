    <div class="row-gap">
      <a href="/" class="btn btn-primary"><%- icon('home') %>На главную</a>
      <a href="/catalog" class="btn btn-ghost">Открыть каталог</a>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
