<%- include('../partials/header') %>
<div class="container page-pad">
  <h1>Жанры, теги и авторы</h1>
  <%- include('../partials/admin-nav') %>

  <section class="section panel" id="genres">
    <div class="section-head"><h2>Жанры (<%= genres.length %>)</h2></div>
    <form method="post" action="/admin/genres" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input class="input input-sm" name="name" placeholder="Новый жанр" required><button class="btn btn-primary btn-sm"><%- icon('plus') %>Добавить</button>
    </form>
    <div class="tax-list">
      <% genres.forEach(function (g) { %>
        <div class="tax-item">
          <form method="post" action="/admin/genres/<%= g.id %>" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input class="input input-sm" name="name" value="<%= g.name %>" required>
            <span class="muted small"><%= g.n %></span>
            <button class="icon-btn small" title="Сохранить" aria-label="Сохранить"><%- icon('check') %></button>
          </form>
          <form method="post" action="/admin/genres/<%= g.id %>/delete" data-confirm="Удалить жанр «<%= g.name %>»? Он пропадёт у <%= g.n %> тайтлов.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="icon-btn small danger" title="Удалить" aria-label="Удалить"><%- icon('trash') %></button>
          </form>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="section panel" id="tags">
    <div class="section-head"><h2>Теги</h2></div>
    <form method="post" action="/admin/tags" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input class="input input-sm" name="name" placeholder="Новый тег" required>
      <select class="input input-sm select" name="tag_group"><% C.TAG_GROUPS.forEach(function (g) { %><option><%= g %></option><% }) %></select>
      <button class="btn btn-primary btn-sm"><%- icon('plus') %>Добавить</button>
    </form>
    <% tagGroups.forEach(function (grp) { %>
      <h3 class="h4"><%= grp.group %></h3>
      <div class="tax-list">
        <% grp.tags.forEach(function (t) { %>
          <div class="tax-item">
            <form method="post" action="/admin/tags/<%= t.id %>" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input class="input input-sm" name="name" value="<%= t.name %>" required>
              <select class="input input-sm select" name="tag_group"><% C.TAG_GROUPS.forEach(function (g) { %><option <%= g === t.tag_group ? 'selected' : '' %>><%= g %></option><% }) %></select>
              <span class="muted small"><%= t.n %></span>
              <button class="icon-btn small" title="Сохранить" aria-label="Сохранить"><%- icon('check') %></button>
            </form>
            <form method="post" action="/admin/tags/<%= t.id %>/delete" data-confirm="Удалить тег «<%= t.name %>»?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="icon-btn small danger" title="Удалить" aria-label="Удалить"><%- icon('trash') %></button>
            </form>
          </div>
        <% }) %>
      </div>
    <% }) %>
  </section>

  <section class="section panel" id="authors">
    <div class="section-head"><h2>Авторы (<%= authors.length %>)</h2></div>
    <p class="muted small">Авторы создаются автоматически при добавлении тайтлов. Здесь можно исправить написание имени.</p>
    <div class="tax-list">
      <% authors.forEach(function (a) { %>
        <div class="tax-item">
          <form method="post" action="/admin/authors/<%= a.id %>" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input class="input input-sm" name="name" value="<%= a.name %>" required>
            <a class="muted small" href="<%= catalogUrl('author', a.slug) %>"><%= a.n %></a>
            <button class="icon-btn small" title="Сохранить" aria-label="Сохранить"><%- icon('check') %></button>
          </form>
        </div>
      <% }) %>
      <% if (!authors.length) { %><div class="empty">Авторов пока нет.</div><% } %>
    </div>
  </section>
</div>
<%- include('../partials/footer') %>
