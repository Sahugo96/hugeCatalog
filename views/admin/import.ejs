<%- include('../partials/header') %>
<div class="container page-pad">
  <h1>Импорт произведений</h1>
  <%- include('../partials/admin-nav') %>

  <% if (report) { %>
    <div class="panel">
      <h2 class="h3">Результат: создано <%= report.filter(function (r) { return r.status === 'created'; }).length %> из <%= report.length %></h2>
      <ul class="import-report">
        <% report.forEach(function (r) { %>
          <li class="import-<%= r.status %>">
            <span class="status status-<%= { created: 'approved', skipped: 'pending', error: 'rejected' }[r.status] %>"><%= { created: 'создано', skipped: 'пропущено', error: 'ошибка' }[r.status] %></span>
            <% if (r.slug) { %><a href="/title/<%= r.slug %>"><%= r.title %></a><% } else { %><strong><%= r.title %></strong><% } %>
            <% if (r.slug && r.status === 'created') { %><a class="small" href="/title/<%= r.slug %>">открыть</a><% } %>
            <% if (r.messages.length) { %><div class="muted small"><%= r.messages.join(' · ') %></div><% } %>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <% if (error) { %><div class="notice notice-error"><%- icon('info') %><div><%= error %></div></div><% } %>

  <form method="post" action="/admin/import" class="form panel">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <p class="muted">Вставьте JSON с одним произведением или массивом. Импортированные произведения публикуются сразу. Записи с одинаковым <code>group</code> связываются как языковые версии; <code>link_to</code> — slug уже существующей версии.</p>
    <label class="field">
      <span>JSON</span>
      <textarea class="input mono" name="json" rows="18" required spellcheck="false" placeholder='[
  {
    "title": "Название", "alt_titles": ["Original title"],
    "description": "Описание…",
    "type": "manhwa", "status": "ongoing", "language": "ru", "age_rating": "16+", "year": 2020,
    "authors": ["Автор"], "artists": ["Художник"],
    "genres": ["Боевик", "Фэнтези"], "tags": ["Регрессия", "Цветная"],
    "cover_url": "https://example.com/cover.jpg",
    "group": "my-work"
  }
]'><%= json %></textarea>
    </label>
    <label class="check"><input type="checkbox" name="create_missing" value="1" <%= options.createMissing ? 'checked' : '' %>><span>Создавать отсутствующие жанры и теги (иначе они пропускаются с предупреждением)</span></label>
    <label class="check"><input type="checkbox" name="skip_covers" value="1" <%= options.skipCovers ? 'checked' : '' %>><span>Не скачивать обложки по ссылкам</span></label>
    <div><button class="btn btn-primary" type="submit"><%- icon('upload') %>Импортировать</button></div>
  </form>
</div>
<%- include('../partials/footer') %>
