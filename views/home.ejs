<%- include('partials/header') %>

<% if (hero.length) { %>
<section class="hero" data-slider>
  <div class="hero-slides">
    <% hero.forEach(function (w, i) { %>
      <article class="hero-slide <%= i === 0 ? 'active' : '' %>" data-slide>
        <div class="hero-bg" style="background-image: url('<%= w.cover %>')"></div>
        <div class="container hero-inner">
          <a href="/title/<%= w.slug %>" class="hero-cover <%= w.age_rating === '18+' ? 'is-adult' : '' %>"><img src="<%= w.cover %>" alt="<%= w.title %>"></a>
          <div class="hero-text">
            <div class="hero-kicker"><%- icon('fire', 'small') %><%= __('Популярное ·') %> <%- flag(w.language) %> <%= labelOf(C.TYPES, w.type) %><% if (w.year) { %> · <%= w.year %><% } %></div>
            <h2 class="hero-title"><a href="/title/<%= w.slug %>"><%= w.title %></a></h2>
            <p class="hero-desc"><%= w.description.length > 260 ? w.description.slice(0, 260) + '…' : w.description %></p>
            <div class="chips">
              <% w.genres.forEach(function (g) { %><a class="chip" href="<%= catalogUrl('genre', g.slug) %>"><%= __(g.name) %></a><% }) %>
            </div>
            <div class="row-gap">
              <a href="/title/<%= w.slug %>" class="btn btn-primary"><%- icon('book') %><%= __('Читать') %></a>
              <span class="hero-stats muted"><%- icon('eye', 'tiny') %><%= util.compactNumber(w.views) %> <%- icon('heart', 'tiny') %><%= util.compactNumber(w.likes_count) %> · <%= w.is_single ? __('сингл') : w.chapters_count + ' ' + __('гл.') %></span>
            </div>
          </div>
        </div>
      </article>
    <% }) %>
  </div>
  <% if (hero.length > 1) { %>
    <div class="hero-dots">
      <% hero.forEach(function (w, i) { %><button class="<%= i === 0 ? 'active' : '' %>" data-dot="<%= i %>" aria-label="<%= __('Слайд {n}', { n: i + 1 }) %>"></button><% }) %>
    </div>
  <% } %>
</section>
<% } else { %>
<section class="hero hero-empty">
  <div class="container hero-inner">
    <div class="hero-text">
      <h1 class="hero-title"><%= __('Добро пожаловать в') %> <%= SITE_NAME %></h1>
      <p class="hero-desc"><%= __('Каталог пока пуст. Создайте команду, пройдите модерацию и загрузите первое произведение!') %></p>
      <div class="row-gap"><a href="/teams/new" class="btn btn-primary"><%- icon('users') %><%= __('Создать команду') %></a><a href="/about" class="btn btn-ghost"><%= __('О сайте') %></a></div>
    </div>
  </div>
</section>
<% } %>

<div class="container">
  <% if (continueList.length) { %>
    <section class="section">
      <div class="section-head">
        <h2><%- icon('bookmark') %><%= __('Продолжить чтение') %></h2>
        <a class="section-link" href="/profile?tab=history"><%= __('История') %> <%- icon('chevronRight', 'small') %></a>
      </div>
      <div class="continue-list">
        <% continueList.forEach(function (w) { %>
          <a class="continue-item" href="/title/<%= w.slug %>/chapter/<%= w.chapter_id %>">
            <img src="<%= w.cover %>" alt="" loading="lazy">
            <span>
              <strong><%= w.title %></strong>
              <span class="muted"><%= __('Глава') %> <%= util.formatChapterNumber(w.chapter_number) %> · <%= util.timeAgo(w.read_at) %></span>
            </span>
          </a>
        <% }) %>
      </div>
    </section>
  <% } %>

  <div class="home-grid">
    <section class="section" id="updates">
      <div class="section-head">
        <h2><%- icon('clock') %><%= __('Свежие обновления') %></h2>
        <a class="section-link" href="/catalog?sort=updated"><%= __('Все') %> <%- icon('chevronRight', 'small') %></a>
      </div>
      <% if (updates.length) { %>
        <div class="updates">
          <% updates.forEach(function (w) { %>
            <div class="update-item">
              <a href="/title/<%= w.slug %>" class="update-cover <%= w.age_rating === '18+' ? 'is-adult' : '' %>"><img src="<%= w.cover %>" alt="" loading="lazy"></a>
              <div class="update-body">
                <div class="update-top">
                  <a href="/title/<%= w.slug %>" class="update-title"><%= w.title %></a>
                  <span class="update-badges"><%- flag(w.language) %><span class="badge badge-soft"><%= labelOf(C.TYPES, w.type) %></span></span>
                </div>
                <ul class="update-chapters">
                  <% if (w.is_single && w.recentChapters[0]) { var g = w.recentChapters[0]; %>
                    <li>
                      <a href="/title/<%= w.slug %>/chapter/<%= g.id %>"><%= __('Сингл') %> · <%= __('{n} стр.', { n: w.pages_total }) %></a>
                      <span class="muted nowrap"><%= util.timeAgo(g.created_at) %></span>
                    </li>
                  <% } else w.recentChapters.forEach(function (c) { %>
                    <li>
                      <a href="/title/<%= w.slug %>/chapter/<%= c.id %>">
                        <% if (c.volume) { %><%= __('Том') %> <%= c.volume %> <% } %><%= __('Глава') %> <%= util.formatChapterNumber(c.number) %><% if (c.title) { %> <span class="muted">— <%= c.title %></span><% } %>
                      </a>
                      <span class="muted nowrap"><%= util.timeAgo(c.created_at) %></span>
                    </li>
                  <% }) %>
                </ul>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty"><%= __('Новых глав пока нет.') %></div>
      <% } %>
    </section>

    <aside class="home-aside">
      <section class="section">
        <div class="section-head"><h2><%- icon('trophy') %><%= __('Топ за сегодня') %></h2></div>
        <% if (topFallback) { %><p class="section-note muted"><%= __('Сегодня ещё тихо — показываем лидеров недели.') %></p><% } %>
        <ol class="rank-list">
          <% topDay.forEach(function (w, i) { %>
            <li>
              <a href="/title/<%= w.slug %>">
                <span class="rank-num rank-<%= i + 1 %>"><%= i + 1 %></span>
                <img src="<%= w.cover %>" alt="" loading="lazy" class="<%= w.age_rating === '18+' ? 'is-adult-img' : '' %>">
                <span class="rank-info">
                  <strong><%= w.title %></strong>
                  <span class="muted"><%- flag(w.language, 'flag-sm') %> <%= labelOf(C.TYPES, w.type) %> · <%- icon('eye', 'tiny') %><%= util.compactNumber(w.views) %> · <%- icon('heart', 'tiny') %><%= util.compactNumber(w.likes_count) %></span>
                </span>
              </a>
            </li>
          <% }) %>
        </ol>
        <% if (!topDay.length) { %><div class="empty"><%= __('Пока нет данных.') %></div><% } %>
      </section>
    </aside>
  </div>

  <%- include('partials/shelf', { id: 'reading', heading: 'Читаемые сегодня', iconName: 'trending', items: reading, link: '/catalog?sort=popular', note: readingFallback ? 'Сегодня ещё никто не читал — показываем самое популярное.' : null, ranked: false, emptyText: 'Пока ничего не читали.' }) %>

  <%- include('partials/shelf', { id: 'new', heading: 'Новинки', iconName: 'sparkles', items: newWorks, link: '/catalog?sort=new', note: null, ranked: false, emptyText: 'Новинок пока нет.' }) %>

  <% if (topWeek.length) { %>
    <%- include('partials/shelf', { id: 'week', heading: 'Топ недели', iconName: 'fire', items: topWeek, link: null, note: null, ranked: true, emptyText: null }) %>
  <% } %>

  <% if (completed.length) { %>
    <%- include('partials/shelf', { id: 'completed', heading: 'Завершённые', iconName: 'check', items: completed, link: '/catalog?status=completed', note: null, ranked: false, emptyText: null }) %>
  <% } %>

  <section class="section">
    <div class="section-head"><h2><%- icon('layers') %><%= __('Жанры') %></h2><a class="section-link" href="/catalog"><%= __('Расширенный поиск') %> <%- icon('chevronRight', 'small') %></a></div>
    <div class="chips chips-lg">
      <% genres.slice().sort(function (x, y) { return __(x.name).localeCompare(__(y.name)); }).forEach(function (g) { %><a class="chip" href="<%= catalogUrl('genre', g.slug) %>"><%= __(g.name) %></a><% }) %>
    </div>
  </section>

  <section class="section stats-band">
    <div><strong><%= util.compactNumber(stats.works) %></strong><span class="muted"><%= __('тайтлов') %></span></div>
    <div><strong><%= util.compactNumber(stats.chapters) %></strong><span class="muted"><%= __('глав') %></span></div>
    <div><strong><%= util.compactNumber(stats.teams) %></strong><span class="muted"><%= __('команд') %></span></div>
    <div><strong><%= util.compactNumber(stats.users) %></strong><span class="muted"><%= __('читателей') %></span></div>
  </section>
</div>

<%- include('partials/footer') %>
