<%- include('../partials/header') %>
<div class="container narrow page-pad">
  <h1><%= __('Настройки') %></h1>
  <% if (errors.length) { %>
    <div class="notice notice-error"><%- icon('info') %><ul><% errors.forEach(function (e) { %><li><%= __(e) %></li><% }) %></ul></div>
  <% } %>
  <div class="panel">
    <h2 class="h3"><%= __('Профиль') %></h2>
    <p class="muted"><%= __('Имя:') %> <strong><%= user.username %></strong> · E-mail: <strong><%= user.email %></strong></p>
    <form method="post" action="/settings/profile" class="form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field"><span><%= __('О себе') %></span><textarea class="input" name="about" rows="4" maxlength="1000"><%= user.about %></textarea></label>
      <button class="btn btn-primary"><%= __('Сохранить') %></button>
    </form>
  </div>
  <div class="panel">
    <h2 class="h3"><%= __('Смена пароля') %></h2>
    <form method="post" action="/settings/password" class="form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field"><span><%= __('Текущий пароль') %></span><input class="input" type="password" name="current" required autocomplete="current-password"></label>
      <div class="field-row">
        <label class="field"><span><%= __('Новый пароль') %></span><input class="input" type="password" name="password" required minlength="8" autocomplete="new-password"></label>
        <label class="field"><span><%= __('Повторите') %></span><input class="input" type="password" name="password2" required minlength="8" autocomplete="new-password"></label>
      </div>
      <button class="btn btn-primary"><%= __('Изменить пароль') %></button>
    </form>
  </div>
  <div class="panel">
    <h2 class="h3"><%= __('Оформление') %></h2>
    <p class="muted"><%= __('Тема переключается кнопкой') %> <%- icon('sun', 'tiny') %>/<%- icon('moon', 'tiny') %> <%= __('в шапке сайта и запоминается в браузере.') %></p>
    <button class="btn btn-ghost" data-theme-reset><%= __('Следовать системной теме') %></button>
  </div>
</div>
<%- include('../partials/footer') %>
