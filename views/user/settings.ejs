<%- include('../partials/header') %>
<div class="container narrow page-pad">
  <h1>Настройки</h1>
  <% if (errors.length) { %>
    <div class="notice notice-error"><%- icon('info') %><ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div>
  <% } %>
  <div class="panel">
    <h2 class="h3">Профиль</h2>
    <p class="muted">Имя: <strong><%= user.username %></strong> · E-mail: <strong><%= user.email %></strong></p>
    <form method="post" action="/settings/profile" class="form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field"><span>О себе</span><textarea class="input" name="about" rows="4" maxlength="1000"><%= user.about %></textarea></label>
      <button class="btn btn-primary">Сохранить</button>
    </form>
  </div>
  <div class="panel">
    <h2 class="h3">Смена пароля</h2>
    <form method="post" action="/settings/password" class="form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field"><span>Текущий пароль</span><input class="input" type="password" name="current" required autocomplete="current-password"></label>
      <div class="field-row">
        <label class="field"><span>Новый пароль</span><input class="input" type="password" name="password" required minlength="8" autocomplete="new-password"></label>
        <label class="field"><span>Повторите</span><input class="input" type="password" name="password2" required minlength="8" autocomplete="new-password"></label>
      </div>
      <button class="btn btn-primary">Изменить пароль</button>
    </form>
  </div>
  <div class="panel">
    <h2 class="h3">Оформление</h2>
    <p class="muted">Тема переключается кнопкой <%- icon('sun', 'tiny') %>/<%- icon('moon', 'tiny') %> в шапке сайта и запоминается в браузере.</p>
    <button class="btn btn-ghost" data-theme-reset>Следовать системной теме</button>
  </div>
</div>
<%- include('../partials/footer') %>
